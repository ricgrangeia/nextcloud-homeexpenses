{
	"name": "ricardo/homeexpenses",
	"description": "Household consumption tracker for Nextcloud: electricity, water and gas bottles",
	"license": "AGPL-3.0-or-later",
	"type": "project",
	"authors": [
		{
			"name": "Ricardo",
			"email": "ricardo@grangeia.pt"
		}
	],
	"autoload": {
		"psr-4": {
			"OCA\\HomeExpenses\\": "lib/"
		}
	},
	"require": {
		"php": "^8.2"
	},
	"require-dev": {
		"phpunit/phpunit": "^10.5",
		"nextcloud/ocp": "dev-stable34"
	},
	"scripts": {
		"test:unit": "phpunit tests -c tests/phpunit.xml --colors=always"
	},
	"config": {
		"optimize-autoloader": true,
		"sort-packages": true,
		"platform": {
			"php": "8.2"
		}
	}
}
